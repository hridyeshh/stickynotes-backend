# Copy to .env for local dev. Never commit .env.

# Local Postgres from `make docker-up`
DATABASE_URL=postgres://stickynotes:stickynotes@localhost:5433/stickynotes?sslmode=disable

# Signs access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# OAuth client ID(s) from the stickynotes Google Cloud project, comma-separated.
# A Google ID token is accepted only if its `aud` is in this list.
GOOGLE_CLIENT_IDS=

PORT=8080

# Reading suggestions (optional; without both keys none are found). Gemini writes searches from a topic's notes,
# Brave Search runs them. Keys from aistudio.google.com and api-dashboard.search.brave.com.
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Comma-separated, tried in order (default gemini-3.8-flash,gemini-3.5-flash-lite). Google retires models: list
# newer ones here when it does.
GEMINI_MODELS=
